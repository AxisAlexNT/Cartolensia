# Cartolensia local full bundle build configuration.
# Copy to config/local-full-build.env and adjust paths on your Internet-connected build machine.

# Build identity and output.
CARTOLENSIA_RELEASE_VERSION=local-full
CARTOLENSIA_RELEASE_DIST_DIR=./dist

# Bundle everything that is reviewed and locally available.
CARTOLENSIA_RELEASE_INCLUDE_TOOLS=1
CARTOLENSIA_RELEASE_INCLUDE_POSTGRES=1
CARTOLENSIA_RELEASE_INCLUDE_PYTHON_RUNTIME=1
CARTOLENSIA_RELEASE_INCLUDE_MODELS=1
CARTOLENSIA_RELEASE_INCLUDE_OFFLINE_MAPS=1
CARTOLENSIA_RELEASE_AI_FLAVOR=cpu

# Optional runner-provided roots for reviewed dependencies.
CARTOLENSIA_FFMPEG_BIN_DIR=/opt/cartolensia-downloads/tools/ffmpeg/bin
CARTOLENSIA_TESSERACT_BIN_DIR=/opt/cartolensia-downloads/tools/tesseract/bin
CARTOLENSIA_TESSDATA_DIR=/opt/cartolensia-downloads/tools/tessdata
CARTOLENSIA_PG_BIN_DIR=/opt/cartolensia-downloads/postgres/bin
CARTOLENSIA_PG_CONFIG=/opt/cartolensia-downloads/postgres/bin/pg_config
CARTOLENSIA_BUNDLED_PYTHON_ROOT=/opt/cartolensia-python
CARTOLENSIA_MODELS_DIR=/opt/cartolensia-models
CARTOLENSIA_OFFLINE_MAPS_DIR=/opt/cartolensia-offline-maps

# Official source references to fetch on the connected machine.
# These are references, not vendored binaries.
CARTOLENSIA_FFMPEG_SOURCE_URL=https://ffmpeg.org/releases/
CARTOLENSIA_TESSERACT_SOURCE_URL=https://github.com/tesseract-ocr/tesseract
CARTOLENSIA_TESSDATA_SOURCE_URL=https://github.com/tesseract-ocr/tessdata
CARTOLENSIA_PYPI_INDEX_URL=https://pypi.org/simple
CARTOLENSIA_PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
CARTOLENSIA_MODEL_APPROVALS_DOC=docs/AI_MODEL_APPROVALS.md
CARTOLENSIA_OFFLINE_MAPS_NOTE=Use PMTiles/MBTiles or a self-hosted tile bundle; do not bulk-prefetch public OSM.
