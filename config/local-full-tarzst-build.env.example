# Cartolensia local full tar.zst build configuration.
# Copy to config/local-full-tarzst-build.env and review before running:
#
#   bash scripts/release/build-local-full-tarzst.sh config/local-full-tarzst-build.env
#
# This is intended for a private/local air-gap bundle built on an Internet-connected
# Linux x86_64 machine. It is not the default GitHub release artifact.

# Build identity and output.
CARTOLENSIA_RELEASE_VERSION=local-full
CARTOLENSIA_LOCAL_FULL_PACKAGE_NAME=cartolensia-local-full-linux-x86_64
CARTOLENSIA_RELEASE_DIST_DIR=dist/release
CARTOLENSIA_LOCAL_FULL_WORK_DIR=dist/local-full-work
CARTOLENSIA_LOCAL_FULL_CACHE_DIR=dist/local-full-cache

# Bundle payload toggles.
CARTOLENSIA_LOCAL_FULL_INCLUDE_FFMPEG=1
CARTOLENSIA_LOCAL_FULL_INCLUDE_TESSERACT=1
CARTOLENSIA_LOCAL_FULL_INCLUDE_POSTGRES=1
CARTOLENSIA_LOCAL_FULL_INCLUDE_AI_ENVS=1
CARTOLENSIA_LOCAL_FULL_INCLUDE_MODELS=1
CARTOLENSIA_LOCAL_FULL_INCLUDE_OFFLINE_MAPS=0

# Build all requested AI envs, or set to 0 for a best-effort package.
CARTOLENSIA_LOCAL_FULL_REQUIRE_ALL_AI_FLAVORS=1
CARTOLENSIA_LOCAL_FULL_PREPARE_MODELS=1
CARTOLENSIA_LOCAL_FULL_REQUIRE_MODELS=1
CARTOLENSIA_LOCAL_FULL_WHISPER_MODEL=small

# Set to 1 to validate staging without downloading/installing Python packages.
CARTOLENSIA_LOCAL_FULL_SKIP_PIP_INSTALL=0

# Hardware/runtime flavors to build. Host drivers/devices still must be present on
# the target host or container; the archive cannot bundle kernel GPU drivers.
CARTOLENSIA_LOCAL_FULL_AI_FLAVORS="cpu-avx2 cpu-avx512 nvidia-cu128 intel-arc rocm-radeon"

# Official/reviewed source URLs.
# BtbN linux64-gpl-shared is a GPL-enabled FFmpeg build. The packager records
# its configure line and refuses --enable-nonfree builds.
CARTOLENSIA_FFMPEG_BUNDLE_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl-shared.tar.xz
CARTOLENSIA_PYPI_INDEX_URL=https://pypi.org/simple
CARTOLENSIA_PYTORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
CARTOLENSIA_PYTORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu128

# Intel ARC and Radeon/ROCm wheel choices change frequently. Keep these explicit
# and review them on the connected build host before enabling. If unset, those
# flavors build with the CPU PyTorch index and remain CPU fallback executors.
CARTOLENSIA_PYTORCH_INTEL_INDEX_URL=https://download.pytorch.org/whl/cpu
# CARTOLENSIA_PYTORCH_ROCM_INDEX_URL=https://download.pytorch.org/whl/rocm6.3

# Optional local sources. Use these to avoid re-downloading.
# CARTOLENSIA_FFMPEG_ARCHIVE=/opt/cartolensia-downloads/ffmpeg-master-latest-linux64-gpl-shared.tar.xz
# CARTOLENSIA_PG_CONFIG=/opt/postgresql/bin/pg_config
# CARTOLENSIA_TESSERACT_BIN=/usr/bin/tesseract
# CARTOLENSIA_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
CARTOLENSIA_MODELS_DIR=.cartolensia/models
# CARTOLENSIA_OFFLINE_MAPS_DIR=/opt/cartolensia-offline-maps

# Target deployment assumptions.
CARTOLENSIA_ORIGINALS_MOUNT=/originals
CARTOLENSIA_DATA_DIR=/var/lib/cartolensia

# Remote executor defaults used by packaged config snippets.
CARTOLENSIA_AI_WORKER_ENDPOINT=http://127.0.0.1:19090
CARTOLENSIA_TRANSCODE_NODE_ENDPOINT=http://127.0.0.1:18081
