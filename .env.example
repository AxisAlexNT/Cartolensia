CARTOLENSIA_HTTP_ADDR=:8080
CARTOLENSIA_CONFIG=config/cartolensia.yaml

CARTOLENSIA_DB_NAME=cartolensia
CARTOLENSIA_DB_USER=cartolensia
CARTOLENSIA_DB_PASSWORD=cartolensia_dev_password
CARTOLENSIA_POSTGRES_PORT=55432
CARTOLENSIA_DATABASE_URL=postgres://cartolensia:cartolensia_dev_password@localhost:55432/cartolensia?sslmode=disable
CARTOLENSIA_MIGRATIONS_DIR=

CARTOLENSIA_WORKERS_ENABLED=true
CARTOLENSIA_WORKER_ID=

CARTOLENSIA_AUTH_MODE=dev_no_auth
CARTOLENSIA_ADMIN_PASSWORD=

CARTOLENSIA_RUN_DB_TESTS=0
CARTOLENSIA_TEST_DATABASE_URL=postgres://cartolensia:cartolensia_dev_password@127.0.0.1:55432/cartolensia?sslmode=disable

CARTOLENSIA_STORAGE_FIXTURE_NAME=fixture
CARTOLENSIA_STORAGE_FIXTURE_KIND=fs
CARTOLENSIA_STORAGE_FIXTURE_ROOT=./testdata/media_fixture
CARTOLENSIA_STORAGE_FIXTURE_MODE=strict_read_only

CARTOLENSIA_LOG_LEVEL=info
