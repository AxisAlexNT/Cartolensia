CARTOLENSIA_HTTP_ADDR=:8080
CARTOLENSIA_CONFIG=config/cartolensia.yaml

CARTOLENSIA_DB_NAME=cartolensia
CARTOLENSIA_DB_USER=cartolensia
CARTOLENSIA_DB_PASSWORD=cartolensia_dev_password
CARTOLENSIA_POSTGRES_PORT=5432
CARTOLENSIA_DATABASE_URL=postgres://cartolensia:cartolensia_dev_password@localhost:5432/cartolensia?sslmode=disable

